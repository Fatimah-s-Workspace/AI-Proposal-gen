generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(cuid())
  name                String?
  email               String               @unique
  emailVerified       DateTime?
  image               String?
  hashedPassword      String?
  companyName         String?
  country             String               @default("Nigeria")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  accounts            Account[]
  sessions            Session[]
  exports             ExportHistory[]
  proposalGenerations ProposalGeneration[]
  auditLogs           AuditLog[]
  memberships         Membership[]
  sentInvites         OrganizationInvite[]

  contentLibraryEntries ContentLibraryEntry[]

  @@index([email])
}

model Organization {
  id                 String                @id @default(cuid())
  name               String
  slug               String                @unique
  // The bidder's own profile. Every proposal is written on behalf of this
  // organization, so this is set once here rather than retyped into each
  // project. All optional - a workspace works without any of it, and the
  // prompt simply says less about the bidder until it's filled in.
  legalName          String?
  registrationNumber String?
  foundedYear        Int?
  teamSize           String?
  profileSummary     String?
  capabilities       String?
  certifications     String?
  pastPerformance    String?
  // Billing identity, shown on invoices. Separate from the profile above,
  // which is about winning bids rather than paying for the tool.
  billingAddress     String?
  billingTaxId       String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  memberships        Membership[]
  invites            OrganizationInvite[]
  projects           Project[]
  subscription       Subscription?
  payments           Payment[]
  usageTracking      UsageTracking[]
  auditLogs          AuditLog[]
  contentLibrary     ContentLibraryEntry[]
}

// role: "owner" | "admin" | "member"
model Membership {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           String       @default("member")
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

// Not consumed yet (Phase 2 invite flow) - added now so the schema doesn't
// need a second migration once invites are built. Follows the same
// hash/expire/delete-on-use shape as VerificationToken.
model OrganizationInvite {
  id              String       @id @default(cuid())
  organizationId  String
  email           String
  role            String       @default("member")
  token           String       @unique
  // Nullable with onDelete: SetNull rather than Cascade - the invite grants
  // access to the organization, not to the person who sent it, so an admin
  // leaving shouldn't silently revoke invites they'd already issued. The
  // invite page falls back to "Someone" when this is null.
  invitedByUserId String?
  expires         DateTime
  createdAt       DateTime     @default(now())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy       User?        @relation(fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([email])
  @@index([invitedByUserId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id                  String                  @id @default(cuid())
  organizationId      String
  title               String
  clientName          String
  opportunityType     String                  @default("Tender")
  sector              String                  @default("General")
  country             String                  @default("Nigeria")
  authority           String?
  deadline            DateTime?
  budgetRange         String?
  // Bid-shaping context. All optional: a project is still usable the moment
  // it has a title and a client, and these are things you often only learn
  // after reading the pack. Everything here is fed to the proposal prompt.
  referenceNumber     String?
  evaluationCriteria  String?
  winThemes           String?
  contractDuration    String?
  incumbent           String?
  submissionLanguage  String                  @default("English")
  status              String                  @default("draft")
  stage               String                  @default("intake")
  complianceScore     Int                     @default(0)
  summary             String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  organization        Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents           TenderDocument[]
  parsedSections      ParsedSection[]
  requirements        Requirement[]
  clauses             TenderClause[]
  supportingEvidence  SupportingEvidence[]
  proposalSections    ProposalSection[]
  generatedContents   GeneratedContent[]
  proposalGenerations ProposalGeneration[]
  exports             ExportHistory[]
  usageTracking       UsageTracking[]
  complianceAnalyses  ComplianceAnalysis[]
  qualityReviews      ProposalQualityReview[]
  proposalIssues      ProposalIssue[]

  contentLibraryEntries ContentLibraryEntry[]

  @@index([organizationId])
  @@index([status])
}

model TenderDocument {
  id                 String               @id @default(cuid())
  projectId          String
  filename           String
  originalName       String
  mimeType           String
  size               Int
  storagePath        String
  extractedText      String?
  parsingStatus      String               @default("pending")
  parsingError       String?
  // A document that parsed fine but could not be analysed in full - too large
  // for the chunk budget, or a chunk that failed. Separate from parsingError
  // because this is a warning on a usable document, not a failure, and the UI
  // colours the two differently.
  analysisNotice     String?
  parsedAt           DateTime?
  sections           Json?
  status             String               @default("uploaded")
  documentType       String               @default("tender_pack") // tender_pack, addendum, clarification, revision, other
  isPrimary          Boolean              @default(false)
  version            Int                  @default(1)
  parentId           String? // For revisions/addendums, references the original document
  revisionNotes      String? // Notes about what changed in this revision
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  project            Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parsedSections     ParsedSection[]
  requirements       Requirement[]
  clauses            TenderClause[]
  supportingEvidence SupportingEvidence[]

  @@index([projectId])
  @@index([documentType])
  @@index([isPrimary])
}

model ParsedSection {
  id         String         @id @default(cuid())
  projectId  String
  documentId String
  title      String
  body       String
  order      Int
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  document   TenderDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  clauses    TenderClause[]

  @@unique([documentId, order])
  @@index([projectId])
  @@index([documentId])
}

model Requirement {
  id                  String               @id @default(cuid())
  projectId           String
  documentId          String?
  sourceClauseId      String?
  title               String
  description         String
  category            String               @default("mandatory")
  confidence          Float                @default(0.0)
  sourceClause        String?
  priority            String               @default("medium")
  status              String               @default("in_progress")
  dueDate             DateTime?
  evidenceNeeded      Json?
  evidenceMatches     Json?
  reviewNotes         String?
  owner               String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  project             Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  document            TenderDocument?      @relation(fields: [documentId], references: [id], onDelete: SetNull)
  sourceClauseRef     TenderClause?        @relation(fields: [sourceClauseId], references: [id], onDelete: SetNull)
  supportingEvidence  SupportingEvidence[]
  requirementMappings RequirementMapping[]

  @@index([projectId])
  @@index([documentId])
  @@index([sourceClauseId])
  @@index([status])
}

model TenderClause {
  id              String         @id @default(cuid())
  projectId       String
  documentId      String
  parsedSectionId String?
  title           String?
  originalText    String
  explanation     String?
  clauseType      String?
  importance      String?
  riskLevel       String?
  confidence      Float          @default(0.0)
  actions         Json?
  actionsRequired Json?
  metadata        Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  document        TenderDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  parsedSection   ParsedSection? @relation(fields: [parsedSectionId], references: [id], onDelete: SetNull)
  requirements    Requirement[]

  @@index([projectId])
  @@index([documentId])
  @@index([parsedSectionId])
  @@index([importance])
}

model SupportingEvidence {
  id            String         @id @default(cuid())
  projectId     String
  documentId    String
  requirementId String?
  detectedType  String
  confidence    Float          @default(0.0)
  status        String         @default("detected")
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  document      TenderDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  requirement   Requirement?   @relation(fields: [requirementId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([documentId])
  @@index([requirementId])
}

model ProposalSection {
  id                  String                  @id @default(cuid())
  projectId           String
  title               String
  slug                String
  order               Int
  content             String?
  sectionType         String                  @default("custom")
  version             Int                     @default(1)
  generatedAt         DateTime?
  prompt              String?
  status              String                  @default("not_started")
  wordTarget          Int                     @default(350)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  project             Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  generatedContents   GeneratedContent[]
  proposalGenerations ProposalGeneration[]
  requirementMappings RequirementMapping[]
  qualityReviews      ProposalQualityReview[]
  proposalIssues      ProposalIssue[]

  contentLibraryEntries ContentLibraryEntry[]

  @@index([projectId])
  @@index([sectionType])
}

model RequirementMapping {
  id                String          @id @default(cuid())
  requirementId     String
  proposalSectionId String
  mappingStrength   String          @default("moderate")
  status            String          @default("mapped")
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  requirement       Requirement     @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  proposalSection   ProposalSection @relation(fields: [proposalSectionId], references: [id], onDelete: Cascade)

  @@index([requirementId])
  @@index([proposalSectionId])
}

model ComplianceAnalysis {
  id            String   @id @default(cuid())
  projectId     String
  overall       Int
  technical     Int
  completeness  Int
  documentation Int
  details       Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProposalQualityReview {
  id                   String           @id @default(cuid())
  projectId            String
  sectionId            String?
  qualityScore         Int
  repetitivenessScore  Int
  genericLanguageScore Int
  weakStatementScore   Int
  recommendations      Json?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  project              Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  section              ProposalSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  issues               ProposalIssue[]

  @@index([projectId])
  @@index([sectionId])
}

model ProposalIssue {
  id              String                 @id @default(cuid())
  projectId       String
  sectionId       String?
  qualityReviewId String?
  issueType       String
  severity        String
  affectedText    String
  recommendation  String
  details         Json?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  project         Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  section         ProposalSection?       @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  qualityReview   ProposalQualityReview? @relation(fields: [qualityReviewId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([sectionId])
  @@index([qualityReviewId])
}

model ProposalGeneration {
  id        String           @id @default(cuid())
  projectId String
  sectionId String?
  userId    String?
  provider  String           @default("gemini")
  status    String           @default("pending")
  prompt    String
  response  String
  metadata  Json?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  section   ProposalSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  user      User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([sectionId])
  @@index([userId])
  @@index([status])
}

model GeneratedContent {
  id          String           @id @default(cuid())
  projectId   String
  sectionId   String?
  provider    String           @default("mock")
  contentType String
  prompt      String?
  output      String
  metadata    Json?
  version     Int              @default(1)
  createdAt   DateTime         @default(now())
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  section     ProposalSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([sectionId])
}

model ExportHistory {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  format    String
  fileName  String
  filePath  String
  status    String   @default("completed")
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([userId])
}

model Subscription {
  id                   String       @id @default(cuid())
  organizationId       String       @unique
  plan                 String       @default("starter")
  status               String       @default("trialing")
  startedAt            DateTime     @default(now())
  renewsAt             DateTime?
  monthlyProposalLimit Int          @default(10)
  monthlyUploadLimit   Int          @default(100)
  // Set when a renewal-reminder email has been sent for the current
  // renewsAt, so the daily cron doesn't re-send it every day until the
  // subscription actually expires. Cleared on every successful payment
  // (finalizePayment sets a new renewsAt), so it naturally resets each cycle.
  reminderSentAt       DateTime?
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// One row per Paystack checkout attempt. `reference` is generated by us
// (not Paystack) before the transaction is initialized, so we can look up
// and finalize a payment idempotently from either the browser callback
// redirect or the server-to-server webhook, whichever arrives first.
model Payment {
  id                String       @id @default(cuid())
  organizationId    String
  // Who clicked checkout - distinct from organizationId (who's billed).
  // Plain field, not a relation: purely informational, shouldn't block
  // deleting a user who's since left the org.
  initiatedByUserId String
  reference         String       @unique
  amount            Int
  currency          String       @default("NGN")
  plan              String
  status            String       @default("pending")
  paidAt            DateTime?
  // Issued once, when the payment succeeds. Unique because two payments
  // sharing an invoice number is an accounting problem, not a display bug.
  invoiceNumber     String?      @unique
  invoicedAt        DateTime?
  // A snapshot of the invoice's contents at the moment it was issued. An
  // invoice is a legal record: if it were re-rendered live from current
  // settings, changing the company address would silently rewrite every
  // invoice ever sent.
  invoiceData       Json?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// One row per notable action a user takes - generation, edit, export,
// delete, payment. Written best-effort: logAudit() swallows its own
// errors so a logging failure can never break the action it's recording.
model AuditLog {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  action         String
  entityType     String?
  entityId       String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([organizationId, createdAt])
}

model UsageTracking {
  id             String       @id @default(cuid())
  organizationId String
  projectId      String?
  period         String
  uploads        Int          @default(0)
  aiGenerations  Int          @default(0)
  exports        Int          @default(0)
  tokensUsed     Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@unique([organizationId, projectId, period])
  @@index([organizationId, period])
}

// An approved answer, kept at workspace level so it outlives the bid it was
// written for. The whole point of the product is that the second tender takes
// an hour instead of a day, and that only happens if good wording stops being
// thrown away when a project closes.
model ContentLibraryEntry {
  id              String    @id @default(cuid())
  organizationId  String
  title           String
  content         String
  // Whitespace- and case-normalised content, carried as a column so the
  // database can refuse a duplicate outright. Checking in application code
  // first meant reading every entry's full text on every save, and still left
  // the window that produces duplicates in practice: a double-clicked
  // "Save to library".
  fingerprint     String
  // Which kind of section this suits, matching ProposalSection.sectionType.
  // Nullable because plenty of good answers - a safety record, an insurance
  // statement - do not belong to one section type.
  sectionType     String?
  // Free text the author adds, searched alongside the title. Stored as an
  // array rather than a comma string so a tag containing a comma does not
  // silently split into two.
  tags            String[]  @default([])
  // Where the text came from, kept so an entry can be traced back to the bid
  // it was approved in. Both nullable and SetNull: deleting the project must
  // not delete the approved answer, which is the asset.
  sourceProjectId String?
  sourceSectionId String?
  createdById     String?
  // Evidence that an entry earns its place. An entry with no uses after
  // several bids is clutter, and the library is only useful while it stays
  // small enough to trust.
  timesUsed       Int       @default(0)
  lastUsedAt      DateTime?
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceProject Project?         @relation(fields: [sourceProjectId], references: [id], onDelete: SetNull)
  sourceSection ProposalSection? @relation(fields: [sourceSectionId], references: [id], onDelete: SetNull)
  createdBy     User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([organizationId, fingerprint])
  @@index([organizationId])
  @@index([organizationId, sectionType])
  @@index([sourceProjectId])
  @@index([sourceSectionId])
  @@index([createdById])
}
