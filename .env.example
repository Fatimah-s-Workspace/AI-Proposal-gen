# Required for Auth.js
AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Local SQLite default
DATABASE_URL="file:./dev.db"

# Production PostgreSQL example:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tenderflow_ai?schema=public"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
UPLOAD_DIR="./uploads"
EXPORT_DIR="./exports"
MAX_UPLOAD_MB="15"
AI_PROVIDER="mock"

# Optional: set this to enable Gemini-backed tender parsing, clause explanation, and proposal generation.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_DOCUMENT_TEXT_LIMIT="45000"
