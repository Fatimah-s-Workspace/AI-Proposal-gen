# Required for NextAuth v4. NEXTAUTH_URL must be the exact deployed URL
# (e.g. https://your-app.vercel.app) in production - NextAuth v4 reads
# NEXTAUTH_URL specifically, not AUTH_URL (that name is for Auth.js v5).
AUTH_SECRET="replace-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# PostgreSQL is required (the app uses the Prisma pg driver adapter). If your
# provider uses connection pooling (e.g. Supabase's pooled connection on port
# 6543), add ?pgbouncer=true to the URL, or use the direct (non-pooled)
# connection string instead - the pg driver adapter does not manage
# pgbouncer transaction-mode prepared statements automatically.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tenderflow_ai?schema=public"

# Also used for the logo in outgoing email. Mail clients fetch that image
# from the public internet, so in production this must be the deployed
# origin - a localhost value leaves the mark blank in real inboxes (the
# wordmark beside it is HTML text, so the emails stay branded either way).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Accounts created on or after this instant must confirm their email before
# they can sign in; anything older is grandfathered in, so turning the rule on
# does not lock out people already using the app. Defaults to the date this
# shipped - only set it to move the line.
EMAIL_VERIFICATION_REQUIRED_AFTER=""
MAX_UPLOAD_MB="15"

# UPLOAD_DIR/EXPORT_DIR are only used when Supabase Storage isn't configured
# below (local-disk fallback, fine for local dev). Do NOT rely on this in
# production on Vercel or similar serverless hosts - their filesystem is
# read-only outside /tmp, and /tmp does not persist between requests.
UPLOAD_DIR="./uploads"
EXPORT_DIR="./exports"

# Required in production: cloud storage for uploaded tender documents and
# generated exports. Get these from Supabase -> Project Settings -> API
# (SUPABASE_URL is the "Project URL", SUPABASE_SERVICE_ROLE_KEY is the
# "service_role" secret key - never expose this key to the client).
# After setting these, run `npm run storage:setup` once to create the
# required "uploads" and "exports" buckets.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Optional: set GEMINI_API_KEY to enable Gemini-backed tender parsing, clause
# explanation, and proposal generation. When the key is missing, or when the
# free-tier quota is exhausted (429/RESOURCE_EXHAUSTED) or the model is
# temporarily unavailable (503), the app automatically falls back to the local
# rule-based provider so the workflow never breaks.
GEMINI_API_KEY=""
# A model name Google has retired fails every request with a 404 rather than
# falling back, because "no longer available" is a configuration error and not
# a transient one. gemini-2.5-flash was the value here until it started
# returning "no longer available to new users"; gemini-3.5-flash is what
# production generates with today. Check the current list before changing it:
# https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL="gemini-3.5-flash"
GEMINI_DOCUMENT_TEXT_LIMIT="45000"

# Required in production: without these, rate limiting falls back to an
# in-memory counter that does not work on serverless hosts (Vercel can spin
# up a fresh instance per request, so the counter barely persists) - meaning
# uploads, AI generations, and every other rate-limited action are effectively
# unlimited. Get these from the Upstash console (a free tier is enough to
# start) -> Redis database -> REST API section.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Recommended in production: without a DSN, Sentry is disabled and nothing
# tells you when something breaks for a real user. Get these from your
# Sentry project -> Settings -> Client Keys (DSN). SENTRY_DSN is used
# server-side; NEXT_PUBLIC_SENTRY_DSN is the same value exposed to the
# browser (a DSN is not a secret - it can only submit events, not read them).
# SENTRY_AUTH_TOKEN/ORG/PROJECT are only needed to upload source maps during
# `next build` for readable stack traces - safe to leave blank otherwise.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# Required in production for password-reset and welcome emails to actually be
# delivered. Brevo's free tier (300 emails/day, no card required) only needs
# a single verified SENDER EMAIL ADDRESS, not a domain with DNS records -
# Settings -> Senders, Domains & Dedicated IPs -> Senders -> Add a sender,
# then click the verification link Brevo emails to that address. Get the API
# key from Settings -> SMTP & API -> API Keys. Without BREVO_API_KEY,
# sendEmail() logs the message to the server console instead of sending it -
# fine for local dev, not for real users. EMAIL_FROM must exactly match the
# verified sender's email address (the display name in "Name <email>" can be
# anything).
BREVO_API_KEY=""
EMAIL_FROM="TenderFlow AI <your-verified-sender@example.com>"

# Required in production to let users pay for the Pro plan. Paystack is free
# to integrate (no monthly fee - it only takes a percentage of real,
# successful transactions), matching the target market (Nigeria/Africa).
# Get the secret key from the Paystack dashboard -> Settings -> API Keys &
# Webhooks (use a test key while developing - test-mode payments don't move
# real money). Also add this app's /api/billing/webhook URL there as a
# webhook. Without PAYSTACK_SECRET_KEY, checkout returns a 503 instead of
# silently granting Pro access - unlike other services in this app, payment
# state is never faked in dev-mode fallback, since granting paid entitlements
# without an actual payment is a real risk, not a convenience.
PAYSTACK_SECRET_KEY=""
# Price of the Pro plan in Naira (not kobo) - change anytime, no code change
# needed. Limits for the Pro plan itself (uploads/AI generations per month)
# are set in src/lib/payments/plans.ts.
PRO_PLAN_PRICE_NGN="5000"

# Protects /api/cron/billing-reminders (Pro plan expiry reminder emails,
# triggered daily via vercel.json's crons config) from being called by
# anyone who finds the URL. Set to any long random string - Vercel
# automatically sends it back as "Authorization: Bearer <value>" once this
# is set as a project env var, matching what the route checks for.
CRON_SECRET=""

# Local convenience only: prefills the sign-in form with the seeded demo
# account so you don't retype it on every restart. Both halves must be set,
# and the prefill is ignored entirely when NODE_ENV is production - these
# were previously hard-coded into the form, which shipped working
# credentials on the public sign-in page.
DEMO_SIGN_IN_EMAIL=""
DEMO_SIGN_IN_PASSWORD=""
