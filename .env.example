# Required for NextAuth v4. NEXTAUTH_URL must be the exact deployed URL
# (e.g. https://your-app.vercel.app) in production - NextAuth v4 reads
# NEXTAUTH_URL specifically, not AUTH_URL (that name is for Auth.js v5).
AUTH_SECRET="replace-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# PostgreSQL is required (the app uses the Prisma pg driver adapter). If your
# provider uses connection pooling (e.g. Supabase's pooled connection on port
# 6543), add ?pgbouncer=true to the URL, or use the direct (non-pooled)
# connection string instead - the pg driver adapter does not manage
# pgbouncer transaction-mode prepared statements automatically.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tenderflow_ai?schema=public"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
MAX_UPLOAD_MB="15"

# UPLOAD_DIR/EXPORT_DIR are only used when Supabase Storage isn't configured
# below (local-disk fallback, fine for local dev). Do NOT rely on this in
# production on Vercel or similar serverless hosts - their filesystem is
# read-only outside /tmp, and /tmp does not persist between requests.
UPLOAD_DIR="./uploads"
EXPORT_DIR="./exports"

# Required in production: cloud storage for uploaded tender documents and
# generated exports. Get these from Supabase -> Project Settings -> API
# (SUPABASE_URL is the "Project URL", SUPABASE_SERVICE_ROLE_KEY is the
# "service_role" secret key - never expose this key to the client).
# After setting these, run `npm run storage:setup` once to create the
# required "uploads" and "exports" buckets.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Optional: set GEMINI_API_KEY to enable Gemini-backed tender parsing, clause
# explanation, and proposal generation. When the key is missing, or when the
# free-tier quota is exhausted (429/RESOURCE_EXHAUSTED) or the model is
# temporarily unavailable (503), the app automatically falls back to the local
# rule-based provider so the workflow never breaks.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_DOCUMENT_TEXT_LIMIT="45000"
